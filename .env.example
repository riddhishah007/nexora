# ── Nexora — Environment Variables (MVP) ──────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# --- AI (LLM Gateway) ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --- Search tool ---------------------------------------------------------
SEARCH_API_KEY=your_search_api_key_here
SEARCH_PROVIDER=tavily
FETCH_PAGE_TIMEOUT_SECONDS=15
FETCH_PAGE_MAX_BYTES=200000

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---------------------------------------------------------------
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexora:nexora_dev_password@postgres:5432/nexora

# --- Redis (cache + queue) ---------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- File storage (local disk for MVP) ---------------------------------------
FILE_STORAGE_PATH=/app/storage

# --- App -----------------------------------------------------------------------
ENVIRONMENT=development
CORE_API_PORT=8000
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
