# =============================================================================
# NEXORA — environment template. Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# =============================================================================

# ---- Core ----
ENVIRONMENT=development
SECRET_KEY=change-me-32+-random-chars

# ---- Database (PostgreSQL 16 + pgvector) ----
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora
DATABASE_URL=postgresql+asyncpg://nexora:change-me@localhost:5432/nexora

# ---- Redis (cache + Celery broker + SSE pub/sub) ----
REDIS_URL=redis://localhost:6379/0

# ---- AI providers ($0 MVP keys) ----
# https://aistudio.google.com/apikey — free tier; used for ALL LLM calls + embeddings
GEMINI_API_KEY=
# https://tavily.com — free tier 1,000 req/month; used by Search Agent
TAVILY_API_KEY=
# Optional local models for development/testing (no key required)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Object storage (dev defaults to local disk) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# ---- Auth ----
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000
